{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias — keep in sync with vite.config.ts resolve.alias */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // erasableSyntaxOnly deliberately OFF: fixed-set values use `const enum` so the
    // same identifier works as both a type and a value (single place to add/rename a
    // member) — see .agents/rules/code-style.md. `const enum` compiles to real runtime
    // code (same as plain `enum` under this project's esbuild bundler), which
    // erasableSyntaxOnly forbids — this project doesn't rely on Node's native
    // type-stripping, so the restriction has no other benefit here.
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
