OPENAI_API_KEY=
# gpt-5.6-luna: cheapest/fastest tier of OpenAI's current flagship family
# ($0.20/$1.20 per 1M tokens as of 2026-07 pricing) — the project runs on a hard $5
# credits cap, and this workload (classifying git-log/PR text, drafting release
# notes) doesn't need Sol/Terra-level reasoning depth to do well.
RELEASE_COPILOT_MODEL=openai/gpt-5.6-luna

# Second model in the agent's model list, tried once after the primary exhausts its
# retries — keeps one outage or rate limit from failing a chat turn outright.
# gpt-5.6-terra: same family, meaningfully stronger than Luna ($2/$12 per 1M) — since
# the fallback only fires when Luna has already failed twice, paying more on those
# rare turns is worth the reliability margin. Must differ from RELEASE_COPILOT_MODEL
# or there is no fallback; nothing validates that for you.
RELEASE_COPILOT_FALLBACK_MODEL=openai/gpt-5.6-terra

VITE_COPILOTKIT_RUNTIME_URL=http://localhost:4111/copilotkit

# --- Slack publishing (see docs/superpowers/specs/2026-08-18-slack-channel-design.md) ---
# Slack Incoming Webhook URL. Create at api.slack.com/apps: Create an app > From scratch
# > Incoming Webhooks > Activate > Add New Webhook to Workspace > choose the channel.
# The URL is bound to that one channel; a different channel means a different URL.
#
# MUST NOT be prefixed with VITE_. Vite inlines every VITE_-prefixed variable into the
# client bundle at build time, which would publish this secret to anyone who opens
# devtools. Nothing in the toolchain warns about this.
SLACK_WEBHOOK_URL=

# Base URL of the Mastra server, used by the browser to reach the publish route above.
# Must point at the same host as VITE_COPILOTKIT_RUNTIME_URL — that variable carries the
# same host with the /copilotkit suffix, and the duplication is accepted here in exchange
# for not string-munging one URL out of the other.
VITE_MASTRA_SERVER_URL=http://localhost:4111

MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

# --- Storage (see src/mastra/index.ts) ---
# Remote libSQL database on Turso (https://turso.tech). When both vars are set, the
# Mastra storage domains (memory/workflows/scores/observability) connect here instead
# of the local file:./mastra.db fallback. Required for any deploy target with an
# ephemeral filesystem — the local file doesn't survive a restart/redeploy there.
# Get the URL and token from the Turso dashboard: database page > Connection URL, and
# the "Create Token" button.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=