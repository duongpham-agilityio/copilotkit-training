GROQ_API_KEY=
# This agent has no tools, so any Groq chat model works. Two things drove the choice:
#   - llama-3.3-70b-versatile has the largest free-tier TPM budget (12K)
#   - it is not a reasoning model, so nothing leaks a <think> block into the reply the
#     way qwen/qwen3.6-27b does, and no completion budget is spent on reasoning
# Free-tier TPM for reference: llama-3.3-70b 12K | qwen3.6-27b 8K | llama-3.1-8b 6K
#
# Avoid openai/gpt-oss-* if tools are ever reintroduced: they leak a harmony channel
# token into the tool name ("attempted to call tool 'skill<|channel|>commentary' which
# was not in request.tools"). See the note in the agent file for why tools are gone.
RELEASE_COPILOT_MODEL=groq/llama-3.3-70b-versatile

VITE_COPILOTKIT_RUNTIME_URL=http://localhost:4111/copilotkit

MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=